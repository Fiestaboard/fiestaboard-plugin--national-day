{
  "id": "national_day",
  "name": "National Day",
  "version": "0.1.4",
  "description": "Display today's national days and fun observances from a bundled dataset.",
  "author": "FiestaBoard Team",
  "icon": "calendar-heart",
  "category": "utility",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--national-day",
  "documentation": "README.md",
  "min_refresh_seconds": 3600,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "holiday_index": {
        "type": "integer",
        "title": "Holiday Position",
        "description": "Which holiday to show when there are multiple (1 = first).",
        "default": 1,
        "minimum": 1,
        "maximum": 5
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to refresh (once per day is sufficient).",
        "default": 3600,
        "minimum": 3600
      }
    },
    "required": []
  },
  "variables": {
    "groups": {
      "holiday": {
        "label": "National Day"
      }
    },
    "simple": {
      "holiday": {
        "description": "Name of the national day / observance",
        "type": "string",
        "max_length": 22,
        "group": "holiday",
        "example": "National Coffee Day"
      },
      "date": {
        "description": "Today's date",
        "type": "string",
        "max_length": 12,
        "group": "holiday",
        "example": "September 29"
      },
      "count": {
        "description": "Total number of observances today",
        "type": "integer",
        "max_length": 3,
        "group": "holiday",
        "example": "3"
      }
    }
  },
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "National Day displayed on a Vestaboard",
      "caption": "Example board output using the default template",
      "primary": true
    }
  ],
  "teaser": "COFFEE DAY 9/29",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "     National Day",
        "     September 29",
        "",
        " National Coffee Day",
        "",
        "3 observance(s) today"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{64}{65} NATIONAL DAY",
        "COFFEE DAY",
        "SEPTEMBER 29"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "National Day Demo",
      "config": {
        "enabled": true,
        "holiday_index": 1,
        "refresh_seconds": 3600
      },
      "template": [
        "National Day",
        "{{national_day.date}}",
        "",
        "{{national_day.holiday}}",
        "",
        "{{national_day.count}} observance(s) today"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "National Day (Note)",
      "template": [
        "NATIONAL DAY",
        "{{national_day.holiday}}",
        "{{national_day.date}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
